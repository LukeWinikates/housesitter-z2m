{{define "device"}}
    <section id="schedule-{{.ScheduleID}}-device-{{.ID}}"
             class="chamfer chip {{.DisplayClasses}}">
        <label for="schedule-{{.ScheduleID}}-device-{{.ID}}-checkbox">
        <header>
            <h3>{{.FriendlyName}}</h3>
        </header>
        <article>
            <div style="display: flex; flex-direction: column; align-items: flex-end">
                <label>
                    <span>add to schedule</span>
                    <input id="schedule-{{.ScheduleID}}-device-{{.ID}}-checkbox" name="device[{{.ID}}][include]" type="checkbox" {{.Checked}} }>
                </label>
                <input type="hidden" name="device[{{.ID}}][id]" value="{{.ID}}">
                <label class="label-fullwidth">
                    <span>Brightness</span>
                    <input type="range" min="0" max="100" style="width:55%;"
                           name="device[{{.ID}}][brightness]"
                           value="{{.Brightness}}"
                           list="markers"/>
                </label>
                <label style="display: none" class="label-fullwidth">
                    Color
                    <input type="color" name="device[{{.ID}}][color]" value="{{.Color}}"/>
                </label>
            </div>
        </article>
        </label>
    </section>
{{end}}
