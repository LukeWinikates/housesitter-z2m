{{define "schedule"}}
    {{ $newMode := eq .ID "new" }}
    <section class="card chamfer flex flex-column" id="schedule-{{.ID}}">
        <form onsubmit="saveSchedule('{{.ID}}',this, event)" id="form-schedule-{{.ID}}">
            <section class="flex">
                <input type="hidden" name="id" value="{{.ID}}">
                <input type="hidden" name="name" value="{{.FriendlyName}}">
                <fieldset class="flex-1">
                    <header>Days Of Week</header>
                    {{ range .DaysOfWeek }}
                        <label>
                            <input type="checkbox" name="daysOfWeek" value="{{.Name}}" {{.Checked}}>
                            {{ .Name }}
                        </label>
                    {{ end }}
                    <button onclick="selectDaysOfWeek(this, event, 'weekdays')">Weekdays</button>
                    <button onclick="selectDaysOfWeek(this, event, 'weekends')">Weekends</button>
                    <button onclick="selectDaysOfWeek(this, event, 'daily')">Daily</button>

                </fieldset>
                <fieldset class="flex-1">
                    <header>Timing</header>
                    <label class="flex flex-end">
                        <span class="flex-1">On at</span>
                        <input class="flex-2" type="time" name="ontime" step="60" value="{{.OnTime.HTMLValue}}">
                    </label>
                    <label class="flex flex-end">
                        <span class="flex-1">Off at</span>
                        <input class="flex-2" type="time" step="60" name="offtime" value="{{.OffTime.HTMLValue}}">
                    </label>
                </fieldset>
                <fieldset class="flex-2">
                    <header>
                        Devices
                    </header>
                    <article class="flex">
                        {{ range .Devices}}
                            {{template "device" .}}
                        {{ end }}
                    </article>
                    <button onclick="toggleDeviceMode('schedule-{{.ID}}', event)">Show All</button>
                    <article class="flex">
                        {{ range .AvailableDevices }}
                            {{template "device" .}}
                        {{ end }}
                    </article>
                </fieldset>
            </section>
        </form>
        <article class="card-buttonbar">
            {{ if $newMode }}
            <button class="chamfer" type="submit" form="form-schedule-{{.ID}}">Create</button>
            {{ else }}
            <button class="chamfer" type="submit" form="form-schedule-{{.ID}}">Update</button>
            <button class="chamfer danger" onclick="destroySchedule('{{.ID}}', '{{.FriendlyName}}', event)">Delete
                {{ end}}
            </button>
        </article>
    </section>
{{end}}